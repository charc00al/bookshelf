<%- include("partials/header.ejs") %>


<main class="homepage-main">

<section class="add-book-search">
    <form class="google-search" action="/submit" method="POST">
        <input type="text" name="input" placeholder="add new book">
        <button class="btn" type="submit">search</button>
    </form>
</section>

<section class="sidebar-wrapper">
    <div class="sidebar">
        <form class="bookshelf-search" action="">
            <input type="text" name="input" placeholder="search bookshelf">
            <button class="btn" type="submit">></button>
        </form>
        <div class="sidebar-text">
            <h4>Status</h4>
            <p>All Books</p>
            <p>Reading</p>
            <p>Wishlist</p>
            <p>Finished books</p>

            <h4>Sort by</h4>
            <p>Date</p>
            <p>Reviews</p>
            <p>Status</p>

            <h4>View</h4>
            <p>Tiles</p>
            <p>Content</p>
        </div>
    </div>
</section>

<section class="google-books-wrapper books-wrapper">
    <div class="google-bookshelf">
        <% if (locals.searchBooks) { %>
            <% searchBooks.forEach(book => { %>
                <div class="google-book book">
                    <h3 class="title"> <%= book.title %></h3>
                    <p class="author"> <%= book.authors %></p>
                    <a href="/new-book/<%=book.isbn%>">
                        <img src="<%= book.cover %>" alt="Book cover">
                    </a>
                    <p> <%= book.isbn %></p>

                </div>
            <% }); %>
        <% } %>
    </div>
</section>

<% if (!locals.searchBooks) { %>
<section class="bookshelf-wrapper books-wrapper">
    <div class="bookshelf">
        <% if (locals.bookshelf) { %>
        <% bookshelf.forEach(book => { %>
            <div class="shelf-book book">
                <img src="<%= book.cover_url %>" alt="Book cover" class="book-cover">
                <h3 class="title"> <%= book.title %></h3>
                <p class="author"> <%= book.author %></p>
            </div>
        <% }); %>
    <% } %>
    </div>
</section>
<% } %>
</main>




<%- include("partials/footer.ejs") %>
